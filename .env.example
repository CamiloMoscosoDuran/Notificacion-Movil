# Backend Local (ASE251S4_T07-be)
# Tu IP local de red detectada es 192.168.0.5 (válida para móvil físico en la misma red Wi-Fi/LAN, emulador y web)
EXPO_PUBLIC_API_URL=http://192.168.0.5:8082

# Alternativas según el entorno de prueba:
# Para navegador Web o iOS Simulator:
# EXPO_PUBLIC_API_URL=http://localhost:8082
# Para Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8082
# Para servidor remoto desplegado:
# EXPO_PUBLIC_API_URL=http://3.228.41.49:30082

